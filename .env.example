# --- DATABASE CONFIGURATION ---
# Thay thế bằng thông tin kết nối PostgreSQL hoặc Supabase của bạn
DATABASE_URL=postgresql://username:password@hostname:port/dbname

# --- SECURITY & AUTHENTICATION ---
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- TELEGRAM BOT WEBHOOK ALERTS ---
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE
TELEGRAM_ALERTS_ENABLED=false

# --- ML HYPERPARAMETER TUNING ---
FINVISTA_TUNE=1
FINVISTA_TUNE_BOOST=1
FINVISTA_TUNE_NITER=30
FINVISTA_TUNE_NITER_BOOST=30

# --- SMOTE DATA BALANCING ---
FINVISTA_USE_SMOTE=1

# --- AI Configuration (OpenRouter & Gemini) ---
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE
OPENROUTER_BATCH_MODEL=openrouter/free
OPENROUTER_DEEP_MODEL=openrouter/free

# --- CACHING LAYER (REDIS) ---
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# --- VNSTOCK CONFIGURATION (COMMUNITY/FREE TIER) ---
# Đăng ký hoặc đăng nhập tại https://vnstocks.com để lấy API Key miễn phí của bạn.
VNSTOCK_API_KEY=YOUR_VNSTOCK_API_KEY_HERE
